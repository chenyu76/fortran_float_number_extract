cabal-version: 2.4
name: fortran-float-num-extract
version: 0.1.0.0

executable fortran_float_num_extract
  main-is: app/Main.hs
  build-depends:
    base >=4.14 && <5,
    fortran-src >=0.15 && <0.18,
    uniplate >=1.6 && <2,
    directory >=1.3,
    filepath >=1.4,
    bytestring >=0.10
  default-language: Haskell2010
  ghc-options: -Wall
